# Preferred on hosted services: HTTP-based delivery through Resend.
# Use a sender address on a domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=Inkspire <no-reply@your-verified-domain.com>

# Alternative: Gmail SMTP using a Google App Password.
EMAIL_USER=
EMAIL_PASS=

# Used to build links in account emails.
FRONTEND_URL=https://inkspireblog.vercel.app

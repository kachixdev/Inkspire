# Recommended for Render Free: Gmail API over HTTPS.
# The refresh token must include the https://www.googleapis.com/auth/gmail.send scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Gmail account authorized by the OAuth credentials.
EMAIL_USER=

# Optional Resend alternative. Gmail API is preferred when its OAuth variables are set.
RESEND_API_KEY=
EMAIL_FROM=

# Gmail SMTP fallback; Render Free blocks outbound SMTP ports.
EMAIL_PASS=

# Used to build links in account emails.
FRONTEND_URL=https://inkspireblog.vercel.app
